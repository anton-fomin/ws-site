---
interface Props {
  command: string
}

const { command } = Astro.props
---

<div class="command not-content" data-copy={command}>
  <code>{command.split('\n').map(line => (
    <span class="line"><span class="prompt" aria-hidden="true">$</span> {line}</span>
  ))}</code>
  <button type="button" aria-label="Copy the command" title="Copy the command">
    <svg class="copy-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="8" y="8" width="12" height="12" rx="2" />
      <path d="M16 8V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h4" />
    </svg>
    <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m5 12 4 4L19 6" />
    </svg>
  </button>
  <span class="status" role="status"></span>
</div>

<script>
  for (const box of document.querySelectorAll<HTMLElement>('[data-copy]')) {
    const button = box.querySelector('button')
    const status = box.querySelector<HTMLElement>('.status')!
    let reset: ReturnType<typeof setTimeout>
    button?.addEventListener('click', async () => {
      clearTimeout(reset)
      try {
        await navigator.clipboard.writeText(box.dataset.copy ?? '')
        button.dataset.copied = 'true'
        button.setAttribute('aria-label', 'Copied')
        button.title = 'Copied'
        status.textContent = 'Command copied'
      } catch {
        status.textContent = 'Press Ctrl+C to copy the selected command'
        getSelection()?.selectAllChildren(box.querySelector('code')!)
      }
      reset = setTimeout(() => {
        delete button.dataset.copied
        button.setAttribute('aria-label', 'Copy the command')
        button.title = 'Copy the command'
        status.textContent = ''
      }, 2000)
    })
  }
</script>

<style>
  .command {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--ws-bg-inset);
    border: 1px solid var(--ws-border);
    border-radius: 6px;
    padding: 0.6rem 0.6rem 0.6rem 1rem;
    max-width: 100%;
  }

  .command code {
    flex: 1;
    min-width: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-size: 0.85rem;
    font-family: var(--ws-font-mono);
    line-height: 1.6;
    margin: 0;
    background: none;
    border: 0;
    padding: 0;
  }

  button {
    display: grid;
    place-items: center;
    align-self: flex-start;
    flex: none;
    font: inherit;
    font-family: var(--ws-font-mono);
    font-size: 0.8rem;
    color: var(--ws-text);
    background: var(--ws-bg-raised);
    border: 1px solid var(--ws-border);
    border-radius: 4px;
    min-width: 2.25rem;
    min-height: 2.25rem;
    padding: 0.4rem;
    cursor: pointer;
  }

  button:hover {
    border-color: var(--ws-accent);
  }

  .line {
    display: block;
  }

  .check-icon,
  button[data-copied] .copy-icon {
    display: none;
  }

  button[data-copied] .check-icon {
    display: block;
    color: var(--ws-accent);
  }

  .status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .prompt {
    color: var(--ws-accent);
    user-select: none;
  }
</style>
